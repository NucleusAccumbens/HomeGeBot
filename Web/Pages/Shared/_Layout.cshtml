<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8"/>
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)"/>
    <meta name="theme-color" content="#1c1c1e" media="(prefers-color-scheme: dark)"/>

    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800;900&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/dashboard/tabs.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/dashboard/cards.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/dashboard/forms.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/dashboard/components.css" asp-append-version="true"/>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#3b82f6',
                        'primary-dark': '#2563eb',
                        neutral: {
                            850: '#1c1c1e',
                            900: '#171717',
                        }
                    },
                    fontFamily: {
                        rubik: ['Rubik', 'sans-serif'],
                        nunito: ['Nunito', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.3/jquery.min.js"></script>
</head>
<body>
    @RenderBody()
    <div id="toast" class="toast"></div>
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
</body>
</html>

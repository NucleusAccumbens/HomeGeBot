@*
    TMA Tab Bar Partial
    Bottom navigation bar with three tabs (Application, My Applications, My Page).
    Matches the admin dashboard's tab bar pattern in Pages/Index.cshtml.
*@
<div class="tab-bar" data-active-tab="applications">
    <button class="tab-btn" data-tab="application" onclick="switchView(event, 'application')">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01m-.01 4h.01" />
        </svg>
        <span data-i18n="tab.application">Заявка</span>
    </button>
    <button class="tab-btn" data-tab="applications" onclick="switchView(event, 'applications')" id="defaultOpen">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <span data-i18n="tab.applications">Мои заявки</span>
    </button>
    <button class="tab-btn" data-tab="profile" onclick="switchView(event, 'profile')">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span data-i18n="tab.profile">Моя страница</span>
    </button>
</div>

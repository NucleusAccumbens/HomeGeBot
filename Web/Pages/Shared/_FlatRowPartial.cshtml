@model Web.Models.FlatViewModel

<tr>
    <td>@Model.PublicationDate</td>
    <td><a href="@Model.Link">Посмотреть объявление</a></td>
    <td>@Model.OwnerNumber</td>
    <td>
        <input type="hidden" name="itemId" value="@Model.ItemId" />
        <input type="text" id="flatComment" name="comment" value="@Model.Comment" title="@Model.Comment" />
    </td>
    <td>
        <div>
            <button class="remove-btn" id="removeBtn">×</button>
            <button class="update-btn" id="updBtn" type="submit">✓</button>
        </div>
    </td>
</tr>





